# ---------------------------------------------------------------------
# Template for the Secret. DO NOT commit a filled-in copy of this file.
# Workflow:
#   1. Copy:    cp openshift/secret.yaml.example openshift/secret.yaml
#   2. Replace every REPLACE_ME below with the real value.
#   3. Apply:   oc apply -f openshift/secret.yaml
#   4. Never commit `openshift/secret.yaml`; it is ignored by .gitignore.
#
# Or create the Secret directly from your local .env without touching
# YAML (recommended for first-time testing):
#
#   oc create secret generic insurance-agent-secrets `
#     --from-env-file=.env `
#     --dry-run=client -o yaml | oc apply -f -
#
# ---------------------------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
  name: insurance-agent-secrets
  labels:
    app: insurance-agent
type: Opaque
stringData:
  # --- Shield / Votal admin + tenant auth (required) -----------------
  SHIELD_ADMIN_KEY: "REPLACE_ME"
  TENANT_API_KEY:   "REPLACE_ME"
  RUNPOD_TOKEN:     "REPLACE_ME"

  # --- LiteLLM proxy (required) --------------------------------------
  # Master key for the Railway-hosted LiteLLM proxy. This is the value
  # passed as `Authorization: Bearer <key>` on every chat-completions
  # request to the proxy.
  LITELLM_API_KEY: "REPLACE_ME"
