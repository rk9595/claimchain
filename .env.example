# ======================================================================
# GEICO Insurance Agent — environment template
# Copy this file to `.env` and fill in the values marked <...>. The real
# `.env` is gitignored; only this template is committed.
# ======================================================================

# ---------------------------------------------------------------------
# LLM-Shield (Votal Shield)
# ---------------------------------------------------------------------
# Base URL of your Shield deployment. Use the RunPod gateway URL if
# Shield is hosted on RunPod, or http://localhost:8000 for a local dev
# build. Do NOT include a trailing slash.
LLM_SHIELD_URL=<https://your-shield-host>

# Admin key for Shield (shown in Shield's admin portal under
# "Platform → Admin keys"). Required by setup_tenant.py to provision
# the tenant and push policies. Not used at runtime.
SHIELD_ADMIN_KEY=<your-shield-admin-key>

# If your Shield is behind the RunPod API gateway, set the RunPod
# bearer token here. Leave blank for self-hosted / local Shield.
RUNPOD_TOKEN=

# ---------------------------------------------------------------------
# Tenant
# ---------------------------------------------------------------------
# Tenant identifier this app runs under. `setup_tenant.py` will create
# it if it does not already exist. Do not change unless you know what
# you're doing — several scripts hard-code "geico-poc".
TENANT_ID=geico-poc

# Leave blank on first run. `setup_tenant.py` will provision the tenant,
# create an API key, and write it back into your .env automatically.
TENANT_API_KEY=

# ---------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------
# For the POC, RAG retrieval is local and embedding-free. OPENAI_API_KEY
# is only needed if you choose to run chat directly against OpenAI. When
# LITELLM_BASE_URL is set, chat calls use LITELLM_API_KEY instead.
OPENAI_API_KEY=<your-openai-key>
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------
# OPTIONAL: route LLM completions through a LiteLLM proxy
# ---------------------------------------------------------------------
# Set LITELLM_BASE_URL to swap direct OpenAI chat calls for the
# OpenAI-compatible LiteLLM proxy. This is how you put the Votal/LiteLLM
# guardrail layer in front of every LLM hop the agent system makes (in
# addition to the Shield checks the host app already runs). RAG does not
# make embedding calls.
#
# Typical setup:
#   1. Start the proxy in litellm/litellm-guardrails-votal-ai/:
#        litellm --config config.yaml --port 4000
#   2. Uncomment the lines below.
#   3. Set LLM_MODEL above to a model_name registered in that config.yaml
#      (e.g. gpt-4.1-mini).
#
# LITELLM_BASE_URL=http://localhost:4000/v1
# LITELLM_API_KEY=sk-litellm-anon
# VOTAL_TENANT_KEY=geico-poc
# VOTAL_USER_ID=geico-agent
# VOTAL_SESSION_ID=geico-session

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
PORT=7860
